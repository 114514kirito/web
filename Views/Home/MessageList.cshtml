@model IReadOnlyList<ContactMessage>

@{
    ViewData["Title"] = "留言管理";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="h2 mb-1">留言管理</h1>
                        <p class="text-secondary mb-0">查看所有通过网站表单提交的留言。</p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">共 @Model.Count 条</span>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="alert alert-info mb-0" role="alert">
                        目前还没有收到任何留言。
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">姓名</th>
                                    <th scope="col">邮箱</th>
                                    <th scope="col">留言内容</th>
                                    <th scope="col">提交时间</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var message in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@message.Name</td>
                                        <td>@message.Email</td>
                                        <td style="min-width: 280px;">@message.Message</td>
                                        <td>@message.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
