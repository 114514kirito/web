@model ProfileViewModel

@{
    ViewData["Title"] = "个人简介";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div id="about-me" class="mb-5">
                <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">
                    <div class="row align-items-center g-4">
                        <div class="col-md-8">
                            <span class="badge bg-primary-subtle text-primary mb-3">About Me</span>
                            <h1 class="display-4 fw-bold mb-3">@Model.Name</h1>
                            <p class="fs-5 text-secondary mb-4">
                                <span id="typed-motto" data-text="@Model.Motto">@Model.Motto</span>
                            </p>
                            <p class="lead mb-4">@Model.Introduction</p>
                            <button type="button"
                                    class="btn btn-primary px-4"
                                    data-bs-toggle="modal"
                                    data-bs-target="#wechatModal">
                                扫码加我微信
                            </button>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center text-md-end">
                                <img src="/images/Image_1777112721982_841.jpg"
                                     class="img-fluid rounded-4 shadow"
                                     alt="@Model.Name 的个人头像" />
                            </div>
                        </div>
                    </div>

                    <div class="mt-5" data-aos="fade-up">
                        <h2 class="h3 mb-3">教育经历</h2>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">时间</th>
                                        <th scope="col">学校</th>
                                        <th scope="col">专业</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var education in Model.EducationHistory)
                                    {
                                        <tr>
                                            <td>@education.TimePeriod</td>
                                            <td>@education.School</td>
                                            <td>@education.Major</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mt-5" data-aos="fade-up" data-aos-delay="120">
                        <h2 class="h3 mb-3">专业技能</h2>
                        <div class="row g-3">
                            @foreach (var skill in Model.Skills)
                            {
                                <div class="col-12">
                                    <div class="border rounded-3 bg-light p-3">
                                        <div class="fw-semibold mb-1">@skill.Category</div>
                                        <div class="text-secondary">@skill.Description</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div id="contact" class="py-5 bg-light rounded-4 p-4 p-md-5 mt-5">
                <h2 class="h2 mb-2">留言与联系</h2>
                <p class="text-secondary mb-4">期待与您的交流，欢迎给我留言！</p>

                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="bg-white rounded-4 shadow-sm p-4 h-100">
                            <h3 class="h4 mb-3">联系信息</h3>
                            <ul class="list-unstyled mb-0">
                                <li class="contact-item mb-3">
                                    <div class="contact-icon">
                                        <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">邮箱</div>
                                        <div class="fw-semibold">@Model.Contact.Email</div>
                                    </div>
                                </li>
                                <li class="contact-item">
                                    <div class="contact-icon">
                                        <i class="bi bi-github" aria-hidden="true"></i>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">GitHub</div>
                                        <a href="@Model.Contact.GitHubUrl" class="fw-semibold text-decoration-none" target="_blank" rel="noreferrer">
                                            @Model.Contact.GitHubUrl
                                        </a>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="bg-white rounded-4 shadow-sm p-4 h-100">
                            <form asp-controller="Home" asp-action="SubmitContact" method="post">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">
                                    <label asp-for="ContactForm.Name" class="form-label">您的姓名</label>
                                    <input asp-for="ContactForm.Name" class="form-control" placeholder="请输入您的姓名" />
                                    <span asp-validation-for="ContactForm.Name" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ContactForm.Email" class="form-label">您的邮箱</label>
                                    <input asp-for="ContactForm.Email" class="form-control" placeholder="name@example.com" />
                                    <span asp-validation-for="ContactForm.Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="ContactForm.Message" class="form-label">留言内容</label>
                                    <textarea asp-for="ContactForm.Message" class="form-control" rows="4" placeholder="请输入您的留言内容"></textarea>
                                    <span asp-validation-for="ContactForm.Message" class="text-danger small"></span>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-2">发送留言</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="wechatModal" tabindex="-1" aria-labelledby="wechatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="wechatModalLabel">我的微信</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img src="/images/wechat-qr.jpg" class="img-fluid rounded" alt="微信二维码" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
